# ==========================================
# Yojana AI Backend Environment Configuration
# Copy this file to .env for local development
# ==========================================

PROJECT_NAME="Yojana AI — Smart Government Scheme Finder"
ENVIRONMENT=development

# JWT Secret Key
# In production, set a secure 32+ character random string (Render generates this automatically)
SECRET_KEY=your_generated_jwt_secret_key_here
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database
# Defaults to SQLite; use PostgreSQL URL in production (e.g., Render Postgres)
DATABASE_URL="sqlite:///./yojana_ai.db"

# Initial Administrator Credentials
# In production, set via private environment variables; do NOT commit real passwords
ADMIN_EMAIL="admin@yojanaai.gov.in"
ADMIN_DEFAULT_PASSWORD=your_secure_admin_password_here

# CORS Configuration
# Set the deployed frontend domain in production (e.g. https://your-app.onrender.com)
FRONTEND_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional: Google Gemini API Key for AI explanations and conversational assistant
# If omitted, deterministic rules engine provides full functionality with fallback
GEMINI_API_KEY=
AI_MODEL_NAME="gemini-1.5-flash"
