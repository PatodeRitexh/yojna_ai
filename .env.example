# ==========================================
# Yojana AI Environment Variables Template
# ==========================================

# Backend Configuration (backend/.env)
PROJECT_NAME="Yojana AI — Smart Government Scheme Finder"
ENVIRONMENT=development
SECRET_KEY=your_generated_jwt_secret_key_here
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080
DATABASE_URL="sqlite:///./yojana_ai.db"
ADMIN_EMAIL="admin@yojanaai.gov.in"
ADMIN_DEFAULT_PASSWORD=your_secure_admin_password_here
FRONTEND_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
GEMINI_API_KEY=
AI_MODEL_NAME="gemini-1.5-flash"

# Frontend Configuration (frontend/.env)
# In production, set to your deployed backend URL (e.g., https://yojana-ai-backend.onrender.com)
VITE_API_BASE_URL=http://127.0.0.1:8000/api
